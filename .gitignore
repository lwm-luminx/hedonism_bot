# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Web app ignored files
/web/.bundle
/web/.env*
/web/log/*
/web/tmp/*
!/web/log/.keep
!/web/tmp/.keep
/web/tmp/pids/*
!/web/tmp/pids/
!/web/tmp/pids/.keep
/web/storage/*
!/web/storage/.keep
/web/tmp/storage/*
!/web/tmp/storage/
!/web/tmp/storage/.keep
/web/config/*.key
/web/app/assets/builds/*
!/web/app/assets/builds/.keep
/web/node_modules
/web/public/vite*
/web/.gem_rbs_collection/

# Legacy / root ignores
/.bundle
/.env*
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
/config/*.key
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules
/public/vite*
node_modules
*.local
.gem_rbs_collection/

# Mac uploader build output
/apple/HedonismUploader/.build/

# Xcode per-user state and local build products
/apple/**/xcuserdata/
/apple/DerivedData/

# Rust build artifacts
target/
**/target/

.DS_Store
.build