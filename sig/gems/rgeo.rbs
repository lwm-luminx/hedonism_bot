module RGeo
  module Cartesian
    # This provides includes some spatial analysis algorithms supporting
    # Cartesian data.
    module Analysis
      # Check orientation of a ring, returns `true` if it is counter-clockwise
      # and false otherwise.
      #
      # If the factory used is GEOS based, use the GEOS implementation to
      # check that. Otherwise, this methods falls back to `ring_direction`.
      #
      # == Note
      #
      # This method does not ensure a correct result for an invalid geometry.
      # You should make sure your ring is valid beforehand using `ring?`
      # if you are using a LineString, or directly `valid?` for a
      # `linear_ring?`.
      # This will be subject to changes in v3.
      def self.ccw?: (untyped ring) -> untyped

      alias self.counter_clockwise? self.ccw?

      def self.ring_direction: (untyped ring) -> (0 | untyped)
    end
  end
end

module RGeo
  module Cartesian
    # This is a bounding box for Cartesian data.
    # The simple cartesian implementation uses this internally to compute
    # envelopes. You may also use it directly to compute and represent
    # bounding boxes.
    #
    # A bounding box is a set of ranges in each dimension: X, Y, as well
    # as Z and M if supported. You can compute a bounding box for one or
    # more geometry objects by creating a new bounding box object, and
    # adding the geometries to it. You may then query it for the bounds,
    # or use it to determine whether it encloses other geometries or
    # bounding boxes.
    class BoundingBox
      @factory: untyped

      @has_z: untyped

      @has_m: untyped

      @min_x: untyped

      @max_x: untyped

      @min_y: untyped

      @max_y: untyped

      @min_z: untyped

      @max_z: untyped

      @min_m: untyped

      @max_m: untyped

      # Returns the bounding box's factory.
      attr_reader factory: untyped

      # Returns true if this bounding box tracks Z coordinates.
      attr_reader has_z: untyped

      # Returns true if this bounding box tracks M coordinates.
      attr_reader has_m: untyped

      # Returns the minimum X, or nil if this bounding box is empty.
      attr_reader min_x: untyped

      # Returns the maximum X, or nil if this bounding box is empty.
      attr_reader max_x: untyped

      # Returns the minimum Y, or nil if this bounding box is empty.
      attr_reader min_y: untyped

      # Returns the maximum Y, or nil if this bounding box is empty.
      attr_reader max_y: untyped

      # Returns the minimum Z, or nil if this bounding box is empty.
      attr_reader min_z: untyped

      # Returns the maximum Z, or nil if this bounding box is empty.
      attr_reader max_z: untyped

      # Returns the minimum M, or nil if this bounding box is empty.
      attr_reader min_m: untyped

      # Returns the maximum M, or nil if this bounding box is empty.
      attr_reader max_m: untyped

      def self.create_from_points: (untyped point1, untyped point2, ?::Hash[untyped, untyped] opts) -> untyped

      def self.create_from_geometry: (untyped geom, ?::Hash[untyped, untyped] opts) -> untyped

      def initialize: (untyped factory, ?::Hash[untyped, untyped] opts) -> void

      def eql?: (untyped other) -> untyped

      alias == eql?

      def empty?: () -> untyped

      def infinitesimal?: () -> untyped

      def degenerate?: () -> untyped

      def center_x: () -> (untyped | nil)

      def x_span: () -> (untyped | 0)

      def center_y: () -> (untyped | nil)

      def y_span: () -> (untyped | 0)

      def center_z: () -> (untyped | nil)

      def z_span: () -> (nil | 0 | untyped)

      def center_m: () -> (untyped | nil)

      def m_span: () -> (nil | 0 | untyped)

      def min_point: () -> (nil | untyped)

      def max_point: () -> (nil | untyped)

      def add: (untyped geometry) -> self

      def to_geometry: () -> untyped

      def contains?: (untyped rhs, ?::Hash[untyped, untyped] opts) -> (untyped | true | false)

      def subdivide: (?::Hash[untyped, untyped] opts) -> ::Array[untyped]

      def add_geometry: (untyped geometry) -> self

      private

      def add_point: (untyped point) -> untyped
    end
  end
end

module RGeo
  module Cartesian
    class Segment
      @s: untyped

      @e: untyped

      @sx: untyped

      @sy: untyped

      @ex: untyped

      @ey: untyped

      @dx: untyped

      @dy: untyped

      @lensq: untyped

      def initialize: (untyped start, untyped stop) -> void

      attr_reader s: untyped

      attr_reader e: untyped

      attr_reader dx: untyped

      attr_reader dy: untyped

      def to_s: () -> ::String

      def eql?: (untyped other) -> untyped

      alias == eql?

      def degenerate?: () -> untyped

      def side: (untyped point) -> untyped

      def tproj: (untyped point) -> (nil | untyped)

      def contains_point?: (untyped point) -> (untyped | false)

      def intersects_segment?: (untyped seg) -> untyped

      # If this and the other segment intersect, this method will return the coordinate
      # at which they intersect, otherwise nil.
      # In the case of a partial overlap (parallel segments), this will return
      # a single point on the overlapping portion.
      #
      # @param seg [Segment]
      #
      # @return [RGeo::Feature::Point, nil]
      def segment_intersection: (untyped seg) -> (untyped | nil)

      def length: () -> untyped
    end
  end
end

