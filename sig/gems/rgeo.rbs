module RGeo
  module Cartesian
    module GeometryMethods
      @graph: untyped

      def srid: () -> untyped

      def envelope: () -> untyped

      def coordinate_dimension: () -> untyped

      def spatial_dimension: () -> untyped

      def is_3d?: () -> untyped

      def measured?: () -> untyped

      private

      def graph: () -> untyped
    end

    module PointMethods
      def distance: (untyped rhs) -> untyped

      def buffer: (untyped distance) -> untyped
    end

    module LineStringMethods
      @segments: untyped

      def segments: () -> untyped

      def simple?: () -> untyped

      def length: () -> untyped

      def crosses?: (untyped rhs) -> untyped

      private

      # Determines if a cross occurs with another linestring.
      # Process is to get the number of proper intersections in each geom
      # then overlay and get the number of proper intersections from that.
      # If the overlaid number is higher than the sum of individual self-ints
      # then there is an intersection. Finally, we need to check the intersection
      # to see that it is not a boundary point of either segment.
      #
      # @param rhs [Feature::LineString]
      #
      # @return [Boolean]
      def crosses_line_string?: (untyped rhs) -> (true | false)
    end

    module MultiLineStringMethods
      def length: () -> untyped
    end
  end
end

