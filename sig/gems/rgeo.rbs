module RGeo
  module Geographic
    # This object represents an axis-aligned rectangle in a map projection
    # coordinate system. It is commonly used to specify the viewport for a
    # map visualization, an envelope in a projected coordinate system, or
    # a spatial constraint. It must be attached to a Geographic::Factory
    # that has a projection.
    class ProjectedWindow
      @factory: untyped

      @x_min: untyped

      @y_min: untyped

      @x_max: untyped

      @y_max: untyped

      @sw_point: untyped

      @se_point: untyped

      @nw_point: untyped

      @ne_point: untyped

      @center_point: untyped

      def initialize: (untyped factory_, untyped x_min_, untyped y_min_, untyped x_max_, untyped y_max_, ?::Hash[untyped, untyped] opts_) -> void

      def to_s: () -> ::String

      def inspect: () -> untyped

      def eql?: (untyped other) -> (false | untyped)

      alias == eql?

      def hash: () -> untyped

      # Returns the Geographic::Factory associated with this window.
      # Note that this factory is the overall geography factory, not the
      # projected factory (which can be obtained by calling
      # Geographic::Factory#projection_factory on this factory).
      attr_reader factory: untyped

      # Returns the lower limit in the x (easting) direction.
      attr_reader x_min: untyped

      # Returns the upper limit in the x (easting) direction.
      attr_reader x_max: untyped

      # Returns the lower limit in the y (northing) direction.
      attr_reader y_min: untyped

      # Returns the upper limit in the y (northing) direction.
      attr_reader y_max: untyped

      def crosses_seam?: () -> untyped

      def degenerate?: () -> untyped

      def x_span: () -> untyped

      alias width x_span

      def y_span: () -> untyped

      alias height y_span

      def center_xy: () -> ::Array[untyped]

      def sw_point: () -> untyped

      def se_point: () -> untyped

      def nw_point: () -> untyped

      def ne_point: () -> untyped

      def center_point: () -> untyped

      def random_point: () -> untyped

      def contains_point?: (untyped point_) -> untyped

      def contains_window?: (untyped window_) -> (nil | untyped)

      def scaled_by: (untyped x_factor_, ?untyped? y_factor_) -> untyped

      alias * scaled_by

      def clamped_by: (untyped min_width_, untyped min_height_, untyped max_width_, untyped max_height_) -> untyped

      def with_margin: (untyped x_margin_, ?untyped? y_margin_) -> untyped

