<% content_for :title, "Signing in · Lumière Archive" %>
<main class="relative flex min-h-screen items-center justify-center px-4 py-8" style="background: var(--background)">
  <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(201,169,110,0.07), transparent 70%)" aria-hidden="true"></div>
  <section class="relative flex w-full max-w-sm flex-col gap-8 border p-8 text-center" style="background: var(--card); border-color: var(--border); border-radius: var(--radius)" aria-labelledby="signin-title">
    <header class="flex flex-col items-center gap-3">
      <img src="/lumiere-mark.svg" alt="" class="h-14 w-14">
      <div>
        <h1 id="signin-title" style="font-family: 'Playfair Display', serif; font-size: 1.375rem; line-height: 1.3">Lumière Archive</h1>
        <p class="mt-1 text-xs" style="color: var(--muted-foreground); font-family: 'DM Mono', monospace">Admin sign-in</p>
      </div>
    </header>
    <div class="h-px" style="background: var(--border)" aria-hidden="true"></div>
    <div class="flex flex-col gap-3">
      <p class="text-sm" role="status">Taking you to Facebook…</p>
      <p class="text-xs leading-relaxed" style="color: var(--muted-foreground)">You’ll return to <%= @login_photographer.name %> after signing in.</p>
      <%= button_to "Continue with Facebook", "/auth/facebook", method: :post,
                    form: { id: "facebook-signin", class: "mt-2" },
                    class: "w-full px-4 py-2.5 text-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-4",
                    style: "background: #1877F2; color: #FFFFFF; border-radius: var(--radius-sm)",
                    data: { turbo: false } %>
      <p class="text-xs" style="color: var(--muted-foreground)">If nothing happens, use the button above.</p>
      <noscript><p class="text-xs">Automatic sign-in needs JavaScript. Use the button to continue.</p></noscript>
    </div>
    <footer class="flex justify-center gap-4 text-xs" style="color: var(--muted-foreground)">
      <a href="/privacy.html" class="hover:underline">Privacy policy</a>
      <a href="/data-deletion.html" class="hover:underline">Data deletion</a>
    </footer>
  </section>
</main>
<%= vite_typescript_tag "auth_bridge.ts" %>
