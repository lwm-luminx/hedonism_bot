<%# GA4 for the Lumière web stream (GA4_MEASUREMENT_ID, production only). Page views on client-side route changes come
    from GA4's enhanced measurement. %>
<% if (ga_id = Rails.configuration.x.google_analytics_id) %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= u ga_id %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', <%= raw ga_id.to_json %>);
  </script>
<% end %>
