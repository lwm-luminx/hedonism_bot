class LayoutItem
  @type: Symbol
  @id: String
  @title: String
  @description: String
  @height: Integer
  @image_url: String?
  @link_url: String
  @distance: Float
  @start_at: ActiveSupport::TimeWithZone

  attr_accessor id: String
  attr_accessor type: Symbol
  attr_accessor title: String
  attr_accessor description: String
  attr_accessor height: Integer
  attr_accessor image_url: String?
  attr_accessor link_url: String
  attr_accessor distance: Float
  attr_accessor start_at: ActiveSupport::TimeWithZone

  def initialize: (Symbol) -> void
end